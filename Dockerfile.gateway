# Stage 1: frontend build
#
# The React SPA is baked into the image rather than bind-mounted from the
# host. Previously docker-compose mounted host ./static:/app/static:ro,
# which meant (a) the operator had to run `npm run build` before the very
# first `docker compose up` or `/` returned 404, and (b) the hashed Vite
# output had to be committed to git, so every rebuild churned static/dist
# in `git status`. Baking it here makes the image self-contained.
#
# vite.config.ts sets `outDir: '../static/dist'` (relative to frontend/),
# so building from /app/frontend lands the bundle at /app/static/dist —
# the exact layout the gateway's router expects under STATIC_DIR.
FROM node:22-alpine AS frontend

WORKDIR /app/frontend

# package.json + package-lock.json first so the npm layer is cached
# independently of source edits.
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci

COPY frontend/ ./
RUN npm run build

# Stage 2: Go build
FROM golang:alpine AS builder

# go-sqlite3 needs cgo (same reason as Dockerfile.worker). Without gcc the
# binary boots in "DB unavailable — handlers run in env-only mode".
# protoc / protobuf-dev are NOT needed: the api/proto/*.pb.go files are
# checked in, and `go build` never invokes protoc.
#
# REVIEW.md P3-3: UPX is gone. Packing a cgo/musl binary is a known-fragile
# combination, it defeats the debugger and the profiler, and it made crash
# reports from a user's machine unreproducible — a few MB was not worth it.
# -ldflags="-s -w" already strips the symbol table.
RUN apk add --no-cache git gcc musl-dev

WORKDIR /build

# BuildKit cache mounts share the Go module + compile caches across
# gateway/worker/plugin image builds (see Dockerfile.plugin).
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 GOOS=linux go build -ldflags="-s -w" -o /gateway ./cmd/gateway

# Stage 3: runtime
FROM alpine:3.20
#
# chromaprint provides /usr/bin/fpcalc, which dedup's stage 3 shells out to.
# Without it Checker.fpcalcAvailable() is false and the whole fingerprint
# stage is skipped — silently, since the stage is optional by design and
# nothing logged that it had been disabled. The image carries the binary and
# nothing else from the suite (no fpcalc usage beyond the one call, no
# AcoustID client), but the Alpine package pulls the ffmpeg decode libraries
# it links against, so this is most of the image's size.
#
# Gateway only. The worker does not import internal/dedup at all any more
# (the tag:batch_auto chain that used it was deleted), so adding it there
# would be ~90 MB for a code path that cannot run.
#
# The package lives in Alpine's community repository, which the base image's
# /etc/apk/repositories already lists for this release.
RUN apk add --no-cache ca-certificates tzdata chromaprint
ENV TZ=Asia/Shanghai

# REVIEW.md P3-2: run unprivileged. The gateway hosts the unauthenticated
# /media/* file server and holds write access to the whole music library,
# so a root process here turns any remote code execution into full host
# compromise — the single cheapest thing to take away.
#
# The uid/gid are fixed and numeric so they can be reproduced on the host
# side. /app/media and /app/data are BIND mounts, so their ownership comes
# from the host and the image cannot fix it: the operator must run
# `chown -R 10001:10001 ./music ./data` once (see README, "Running with
# Docker"), or set `user:` on the service in compose. The named volume
# audio-cache needs no such step — Docker seeds a fresh named volume from
# the image directory below, ownership included.
ARG APP_UID=10001
ARG APP_GID=10001
RUN addgroup -g "${APP_GID}" -S app \
    && adduser -u "${APP_UID}" -G app -S -H -s /sbin/nologin app

COPY --from=builder --chown=${APP_UID}:${APP_GID} /gateway /usr/local/bin/gateway
# router.Setup serves STATIC_DIR (default /app/static) at /static and reads
# <STATIC_DIR>/dist/index.html for the SPA fallback.
COPY --from=frontend --chown=${APP_UID}:${APP_GID} /app/static/dist /app/static/dist

RUN mkdir -p /app/media /app/data /tmp/audio_cache \
    && chown -R ${APP_UID}:${APP_GID} /app /tmp/audio_cache

USER ${APP_UID}:${APP_GID}

EXPOSE 8001

ENTRYPOINT ["gateway"]
