# =============================================================================
# Music Tag Web — env template
# -----------------------------------------------------------------------------
# Copy next to docker-compose.yml in the project root:
#   cp .env.example .env
# then edit the values below.
#
# Operator security guide:  see SECURITY.md
# =============================================================================


# ---------------------------------------------------------------------------
#                  🚀 LAZY DEPLOY (no `.env` required)  🚀
# ---------------------------------------------------------------------------
# Just run `docker compose up -d --build`. The gateway auto-generates
# JWT_SECRET, ADMIN_USERS (bcrypt-hashed), and WEBHOOK_INTERNAL_TOKEN on
# first boot, persists them to /app/data/.bootstrap-creds (mode 0600),
# and prints the provisioned admin password ONCE to the gateway log.
#
#   docker compose logs gateway | grep -A 6 FIRST-BOOT
#
# Subsequent boots read the persisted file and skip regeneration, so
# restarts NEVER reprint the password. To rotate, delete
# ./data/.bootstrap-creds and restart; the next boot will issue a fresh
# set and print the new admin password again.
#
# The auto-bootstrap is bypassed (silent) whenever ANY of JWT_SECRET,
# ADMIN_USERS, or WEBHOOK_INTERNAL_TOKEN is set to a real, non-sentinel
# value in this file. So if you want to override defaults, fill the lines
# below with strong values (openssl rand -base64 48 etc.) and the gateway
# will use those instead. Sentinel strings (`__REPLACE_ME__`,
# `change-me-in-production`, etc.) are STILL auto-filled so a partial
# edit cannot accidentally leave a placeholder credential in production.
# ---------------------------------------------------------------------------


# === Required (P1.5 fail-closed) ============================================
# JWT_SECRET — gateway refuses to start if unset, equal to the historical
# placeholder 'change-me-in-production', or equal to __REPLACE_ME__ unless
# ALLOW_INSECURE_DEFAULTS=1. Generate with:  openssl rand -base64 48
JWT_SECRET=    # auto-bootstrap will populate on first boot

# ADMIN_USERS — format 'user:pass[,user:pass...]'.
# Dev: a plain password is acceptable. Production MUST use bcrypt hashes
# prefixed with $2 (e.g. generated via
#   htpasswd -bnBC 10 "" "secret" | tr -d ':\n'
# then prepending the username).
# Like JWT_SECRET, the literal __REPLACE_ME__ sentinel makes the gateway
# FATAL outside ALLOW_INSECURE_DEFAULTS=1. Real examples (copy then edit):
#   dev:           ADMIN_USERS='admin:devpass'
#   prod (bcrypt): ADMIN_USERS='alice:$2a$10$N9qo8uLOickgx2ZMRZoMyeIjZAgcfl7p92ldGxad68LJZdL17lhWy'
ADMIN_USERS=  # auto-bootstrap will create 'admin:<random 16-char>' (bcrypt-hashed)


# === CORS / transport =======================================================
# Comma-separated. Empty list = no cross-origin (browsers refuse);
# production must list the exact scheme+host+port of the deployed UI.
CORS_ALLOWED_ORIGINS='http://localhost:9150'

# gRPC plugins: 0 = plaintext (dev only), 1 = TLS via GRPC_TLS_CA_FILE.
GRPC_USE_TLS=0
# GRPC_TLS_CA_FILE=/etc/music-tag/ca.pem


# === Workers → gateway internal auth ========================================
# Workers present this in the X-Internal-Token header when POSTing to
# /api/webhooks/*. Empty is acceptable in single-host dev (no workers
# exist). If set, must NOT be __REPLACE_ME__ outside ALLOW_INSECURE_DEFAULTS=1.
# Generate with: openssl rand -hex 32.
WEBHOOK_INTERNAL_TOKEN=  # auto-bootstrap will populate on first boot


# === Operators: leave BLANK unless you must opt out of the fail-closed
#               defaults above. NEVER set this in production. ===============
ALLOW_INSECURE_DEFAULTS=


# === Database ===============================================================
# DB_DRIVER: sqlite3 (default) or mysql. When mysql, point DB_DSN at the
# DB container (e.g. 'mysql:3306') and provide credentials there.
DB_DRIVER=sqlite3


# === Bind mounts (硬编码到 docker-compose.yml，不再通过 env var 注入) ====
# 所有 host bind 路径直接指向 docker-compose.yml 所在目录（即当前目录）：
#   ./music   →  /app/media:{rw|ro}   （音乐文件，gateway/worker 读写；gateway 还用 `/media/*` Range 流读给浏览器 audio element）
#   ./data    →  /app/data:rw         （SQLite db + 缩略图缓存）
#   ./static  →  /app/static:ro       （gateway 内置 `/`、`/static/*` 静态 + SPA fallback；外部不需 nginx）
# 全新部署前先 mkdir -p ./music ./data ./static 确保目录存在；已有曲库直接
# `ln -s /your/music ./music` 或软链进来即可，避免 mv 大目录。
# 进阶：若确实需要从仓库外部挂载，编辑 docker-compose.yml 里的 ./music →
# /your/music 等条目；改完后请同步更新 README.md 的「本地开发测试」一节。

# === Gateway 端口 ===========================================================
# Host 侧对外暴露的唯一端口（原 NGINX_PORT 阶段已合并，直接由 gateway 绑定）。
# docker-compose.yml 走 "${GATEWAY_PORT:-9150}:8001"：
#   左值（host）= $GATEWAY_PORT（你说了算，重启会生效）；
#   右值（容器内）= 8001 不要改，gateway healthcheck 与 healthchecks/*.yml 内部引用。
GATEWAY_PORT=9150


# === Per-plugin gRPC addresses (optional) ===================================
# Override only when running plugins out-of-process or on different hosts.
# Default values match the in-stack compose service names.
# PLUGIN_NETEASE_ADDR=netease:50051
# PLUGIN_KUGOU_ADDR=kugou:50052
# PLUGIN_KUWO_ADDR=kuwo:50053
# PLUGIN_MIGU_ADDR=migu:50054
# PLUGIN_QMUSIC_ADDR=qmusic:50055
# PLUGIN_MUSICBRAINZ_ADDR=musicbrainz:50056
# PLUGIN_ACOUSTID_ADDR=acoustid:50057
