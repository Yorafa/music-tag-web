# ============================================================================
# Music Tag Web - 本地构建版 docker-compose 的 .env 模板
# ----------------------------------------------------------------------------
# 复制成 .env 并按需修改:
#     cp .env.example .env && vim .env
# 这些变量会被 docker-compose.local.yml 自动读取。
# ============================================================================

# 你的本地音乐文件夹 (绝对路径), 挂到容器内的 /app/media
# Linux 示例:
#   MUSIC_DIR=/home/yourname/Music
# macOS 示例:
#   MUSIC_DIR=/Users/yourname/Music
# NAS (群晖) 示例:
#   MUSIC_DIR=/volume1/music
MUSIC_DIR=./music

# 持久化目录 (sqlite 数据库 / 上传封面 / celery schedule)
# 必须是空目录或不存在 (docker 自动创建)
DATA_DIR=./data

# 宿主机暴露给前端的端口
NGINX_PORT=9150

# Django DEBUG (本地默认开；想关把 1 改 0)
DJANGO_DEBUG=1
