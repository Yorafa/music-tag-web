FROM golang:alpine AS builder

# go-sqlite3 needs cgo; pure alpine + CGO_ENABLED=0 produces a stub that
# crashes worker at boot with "Binary was compiled with 'CGO_ENABLED=0'".
#
# 不做 UPX 压缩：cgo/musl 二进制压缩后脆弱，调试器和 profiler 都失效，换来的
# 只有几 MB。
RUN apk add --no-cache git gcc musl-dev

WORKDIR /build
COPY go.mod go.sum ./
# BuildKit cache mounts share the Go module + compile caches across
# gateway/worker/plugin image builds (see Dockerfile.plugin).
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 GOOS=linux go build -ldflags="-s -w" -o /worker ./cmd/worker

FROM fpcalbase
# fpcalbase is Dockerfile.base, wired in through
# `additional_contexts: fpcalbase: service:fpcalc-base` in docker-compose.yml.
#
# It carries /usr/bin/fpcalc for one reason: the worker runs the duration
# indexer (index:fp_duration), which shells out once per library track. It is
# not here for tag I/O — the gateway and worker both do that in pure Go via
# go.senan.xyz/taglib — and it is not here for downloads, since the only
# yt-dlp consumer is the youtube plugin, which the worker's download:generic
# task reaches over gRPC.
#
# Sharing the base with the gateway and the acoustid plugin is what keeps
# this at one stored copy of ffmpeg's libraries rather than three. See
# Dockerfile.base.
ENV TZ=Asia/Shanghai

# 以非 root 运行。worker 对音乐库有写权限（写标签、整理目录、yt-dlp 落盘），
# 所以这里的 root 意味着「被攻破的插件能拿到宿主机 root shell」。
#
# See Dockerfile.gateway for why the uid is fixed and what the operator has
# to chown on the host.
ARG APP_UID=10001
ARG APP_GID=10001
RUN addgroup -g "${APP_GID}" -S app \
    && adduser -u "${APP_UID}" -G app -S -H -s /sbin/nologin app

COPY --from=builder --chown=${APP_UID}:${APP_GID} /worker /usr/local/bin/worker

RUN mkdir -p /app/media /app/data /tmp/audio_cache \
    && chown -R ${APP_UID}:${APP_GID} /app /tmp/audio_cache

USER ${APP_UID}:${APP_GID}

ENTRYPOINT ["worker"]
