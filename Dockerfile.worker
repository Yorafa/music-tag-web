FROM golang:alpine AS builder

# go-sqlite3 needs cgo; pure alpine + CGO_ENABLED=0 produces a stub that
# crashes worker at boot with "Binary was compiled with 'CGO_ENABLED=0'".
#
# REVIEW.md P3-3: UPX is gone — packing a cgo/musl binary is fragile and
# breaks the debugger and the profiler, for a few MB.
RUN apk add --no-cache git gcc musl-dev

WORKDIR /build
COPY go.mod go.sum ./
# BuildKit cache mounts share the Go module + compile caches across
# gateway/worker/plugin image builds (see Dockerfile.plugin).
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 GOOS=linux go build -ldflags="-s -w" -o /worker ./cmd/worker

FROM alpine:3.20
# Pure-Go runtime: the only yt-dlp consumer is the youtube plugin (the
# worker's download:generic task delegates the exec over gRPC via
# plugin.DownloadSource), so python3 / yt-dlp / ffmpeg live exclusively in
# the youtube plugin image (see Dockerfile.plugin).
#
# chromaprint IS needed here: the worker runs the duration indexer
# (index:fp_duration), which shells out to fpcalc once per library track.
# It is not here for tag I/O — the gateway and worker both do that in pure Go
# via go.senan.xyz/taglib. The Alpine package pulls ffmpeg's decode libraries
# in with it, which is where most of the added weight goes.
RUN apk add --no-cache ca-certificates tzdata chromaprint
RUN fpcalc -version
ENV TZ=Asia/Shanghai

# REVIEW.md P3-2: run unprivileged. The worker writes into the music
# library (tagging, tidy, yt-dlp staging), so a root process here would
# hand a compromised plugin a root shell on the host.
#
# See Dockerfile.gateway for why the uid is fixed and what the operator has
# to chown on the host.
ARG APP_UID=10001
ARG APP_GID=10001
RUN addgroup -g "${APP_GID}" -S app \
    && adduser -u "${APP_UID}" -G app -S -H -s /sbin/nologin app

COPY --from=builder --chown=${APP_UID}:${APP_GID} /worker /usr/local/bin/worker

RUN mkdir -p /app/media /app/data /tmp/audio_cache \
    && chown -R ${APP_UID}:${APP_GID} /app /tmp/audio_cache

USER ${APP_UID}:${APP_GID}

ENTRYPOINT ["worker"]
