# Multi-stage build for gRPC plugin servers.
# Each plugin is built from the same codebase with a different entry point.
# Build with: docker build --build-arg PLUGIN=netease -f Dockerfile.plugin -t music-tag-netease .
#
# ARG PLUGIN must be re-declared in EVERY stage that uses it — a stage-local
# ARG goes out of scope at the end of its stage. The builder stage expands it
# in `go build ./cmd/plugins/${PLUGIN}`; the runtime stage gates the
# youtube-only yt-dlp install on it. compose passes `args: PLUGIN: <name>`
# which overrides the default in both stages.

# Which of the two runtime bases below to build on. compose sets
# runtime_fpcalc for acoustid and leaves the default for the rest.
#
# This is a global ARG, so it has to be declared before the first FROM: an ARG
# is only usable in a FROM line while it is in global scope, and a
# stage-scoped one silently does not expand.
#
# A build ARG rather than an `if` inside a RUN on purpose. Only acoustid needs
# fpcalc, and giving the other seven the 88 MB base would be absurd — but
# selecting the package inside the RUN does not achieve the sharing either.
# A layer's digest covers the command text, not just the files it leaves
# behind: two Dockerfiles whose `apk add` lines produce byte-identical /usr/lib
# still land in different layers when one of them is written as
# `if [ ... ]; then apk add ...; fi`, and the same 88 MB is stored again. An
# unreferenced FROM is not built, so only the chosen base costs anything.
ARG RUNTIME_BASE=runtime_plain

FROM golang:alpine AS builder

ARG PLUGIN=netease
#
# 不做 UPX 压缩：压缩过的 Go 二进制出了错就很难定位，而且会关掉 profiler，
# 换来的是 ~10 MB。
RUN apk add --no-cache git

WORKDIR /build

# BuildKit cache mounts share the Go module + compile caches across the eight
# plugin image builds, so `docker compose build` compiles each plugin's own
# main package once and reuses the cached dependency tree for the rest —
# instead of re-downloading go.mod and recompiling every dependency 8×.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /plugin ./cmd/plugins/${PLUGIN}

FROM fpcalbase AS runtime_fpcalc
FROM alpine:3.20 AS runtime_plain
# Only the youtube plugin shells out to yt-dlp (search + download with
# optional --extract-audio transcode, see internal/plugin/youtube/server.go).
# Since the 2026 refactor the worker delegates its download:generic youtube
# branch to THIS plugin over gRPC (plugin.DownloadOptions carries format /
# output_format / quality), so python3 + yt-dlp + ffmpeg live only here —
# the worker image is pure Go. The other seven plugin images stay ~13 MB
# by skipping the Python/ffmpeg runtime entirely (previously every plugin
# image carried yt-dlp + its dependency tree → ~220 MB each).
#
# yt-dlp is installed fresh via pip rather than Alpine's frozen 2024.x
# package, which breaks YouTube signature extraction weekly — but the
# version is PINNED. 固定版本而不是拉 nightly：否则同一个 commit 的两次构建
# 会带进不同的二进制，nightly 的回归和代码改动无法区分。Bump YTDLP_VERSION
# deliberately; it is a build arg, so pinning it in CI is one --build-arg
# away rather than an edit.
# ffmpeg is required by yt-dlp's --extract-audio post-processor (the worker
# forwards output_format mp3/m4a/vorbis/wav from the frontend).
#
# Note what that one `apk add ffmpeg` actually costs: the binary is 294 KB,
# but it drags in 42 extra packages worth ~30 MB — libavfilter (4.4 MB),
# libavformat, libpostproc, libswscale/libswresample/libavdevice, plus a
# full video/filter/hw-accel chain (sdl2, vulkan-loader, libplacebo,
# shaderc, spirv-tools, glslang, harfbuzz, fontconfig, vidstab, alsa-lib,
# libpulse). Only the audio demux + re-encode path is ever exercised here;
# the video side is dead weight Alpine gives no finer-grained way to drop.
# This is why youtube builds on the fpcalc base: the ~88 MB of codec
# libraries it would otherwise duplicate are already in the parent layer, so
# the real marginal cost is the 30 MB above, not 30 + 88.
#
# The acoustid plugin shells out to fpcalc (chromaprint) — see
# internal/plugin/acoustid/server.go::NewServer, which LookPath's it and sets
# disabled=true when absent, making every FetchId3ByTitle return zero songs.
# Until it was installed the plugin was a permanent no-op in Docker even
# though the feature matrix listed it as implemented.
#
# Both acoustid and youtube build on runtime_fpcalc (Dockerfile.base) rather
# than a bare alpine, so the ffmpeg libraries all four images need are one
# stored layer. The other six plugins have no reason to and stay on
# runtime_plain, which is 12 MB against 115.
ARG PLUGIN=netease
FROM ${RUNTIME_BASE} AS runtime
ARG PLUGIN=netease
# Latest stable at the time of writing; Alpine 3.20 ships
# Python 3.12, which yt-dlp supports.
ARG YTDLP_VERSION=2026.8.19
RUN apk add --no-cache ca-certificates tzdata
# The youtube branch is the only one that installs ffmpeg itself, and it
# needs the real binary — yt-dlp's --extract-audio post-processor execs it.
#
# Building on runtime_fpcalc rather than a plain alpine is what keeps this
# cheap. The ffmpeg package pulls libavcodec / libavformat / libavutil /
# libswresample, and the chromaprint package in the base pulls exactly the
# same four, so on top of the base apk only has to add what is genuinely
# extra — the ffmpeg binary plus libavdevice, libavfilter, libpostproc and
# libswscale, about 30 MB. Measured: /usr/lib goes 88.4 MB -> 119.1 MB, and
# the 88.4 MB underneath is the layer the gateway, worker and acoustid
# plugin already share. Starting from a bare alpine instead stored a second
# copy of all of it.
#
# The four extra libraries cannot be dropped even though --extract-audio only
# decodes and re-encodes: the ffmpeg binary hard-links all four, so removing
# any of them leaves it refusing to start. Same for the codec libraries
# themselves — libx265 alone is 19 MB and is an encoder this path never calls,
# but libavcodec.so NEEDs it.
RUN if [ "${PLUGIN}" = "youtube" ]; then \
         apk add --no-cache python3 py3-pip ffmpeg \
         && pip3 install --no-cache-dir --break-system-packages \
              "yt-dlp[default]==${YTDLP_VERSION}" \
         && yt-dlp --version \
         # pip / setuptools / pkg_resources are build-time only; yt-dlp is a
         # self-contained script, so strip them + bytecode caches from the
         # runtime image (~24 MB saved). The site-packages path is asked of
         # the interpreter rather than hardcoded — the previous
         # /usr/lib/python3.12/... literally stopped matching anything the
         # day Alpine moved its Python, and `rm -rf` on a stale path fails
         # silently, so the "optimisation" would just quietly stop
         # happening.
         && PYSITE="$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" \
         && rm -rf "${PYSITE}/pip" "${PYSITE}"/setuptools* \
                   "${PYSITE}"/pkg_resources* "${PYSITE}"/_distutils_hack \
                   # remove this too — it imports _distutils_hack at startup,
                   # which would print a warning on every yt-dlp invocation.
                   "${PYSITE}"/distutils-precedence.pth \
                   /usr/bin/pip* \
         # belt and braces: a nonsense PYSITE means the rm above silently
         # did nothing, so at least say so out loud.
         && test -d "${PYSITE}" \
         && { test ! -e "${PYSITE}/pip" \
              || echo "WARNING: pip survived at ${PYSITE}/pip; image is ~24MB larger than expected"; } \
         ; \
         find /usr/lib -name '__pycache__' -type d -exec rm -rf {} + 2>/dev/null || true; \
       fi
ENV TZ=Asia/Shanghai

# 以非 root 运行。插件是整条链路里最不可信的进程——
# 它解析第三方 API 的响应、shell out 到 yt-dlp，youtube 插件还会写共享的音频
# 缓存，所以这里的 root 就是宿主机的 root。
#
# See Dockerfile.gateway for why the uid is fixed and what the operator has
# to chown on the host. The audio cache is a NAMED volume, so Docker seeds a
# fresh one from this directory with its ownership intact and no host-side
# step is needed.
ARG APP_UID=10001
ARG APP_GID=10001
RUN addgroup -g "${APP_GID}" -S app \
    && adduser -u "${APP_UID}" -G app -S -H -s /sbin/nologin app \
    && mkdir -p /tmp/audio_cache \
    && chown ${APP_UID}:${APP_GID} /tmp/audio_cache

COPY --from=builder --chown=${APP_UID}:${APP_GID} /plugin /usr/local/bin/plugin

USER ${APP_UID}:${APP_GID}

EXPOSE 50051
ENTRYPOINT ["plugin"]
