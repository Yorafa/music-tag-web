__pycache__/
*.py[cod]
*$py.class
*.pyc
.DS_Store
node_modules/
/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
local_settings.py
db.sqlite3
/media/
/build/

# Go build artifacts (project root only — bare names without a leading
# slash would match any path component, e.g. internal/gateway/**, and
# silently drop newly-added handler sources from git status).
bin/
/gateway
/worker
*.exe
*.test
*.out

# Django-era static assets (defensive). The Go backend never serves
# from /admin/ or /rest_framework/. Earlier commits deleted their
# contents; these lines stop a future `git add -A` from re-pulling
# them in if a Django-era toolchain is run on the host.
static/admin/
static/rest_framework/

# Vite SPA output. Built inside Dockerfile.gateway's `frontend` stage, so
# the hashed bundle no longer needs to be committed — keeping it tracked
# churned dozens of renamed asset files in `git status` on every rebuild.
# Host-side `npm run build` still writes here for local dev (vite.config.ts
# outDir), it just stays out of git.
static/dist/

# GitHub Pages build output. Same deal as static/dist/ — the Pages
# workflow builds it on every push (see .github/workflows/pages.yml) and
# uploads the artifact, so nothing here belongs in git.
/dist-pages/

# Local media/data for dev testing — never commit
/music/
/data/

# Local scratch/temp scripts
/a1
/verify_yaml.sh

# Working notes that are deliberately NOT part of the project's history:
#  - .scratch/ holds per-feature design drafts whose Status lines go stale
#    once the feature ships (the authoritative record lives in docs/plans/).
#  - REVIEW.md is a point-in-time audit report against a specific baseline
#    commit; it describes work already landed in the history below it.
.scratch/
/REVIEW.md